# Copiar a .env y completar. El .env no se sube a git.

# ── El LLM: para conversar y para «marca y modelo» de un aparato ─────────────
# Dos posibles; se usa UNO. Sin ninguna clave el cerebro arranca igual: HUD, cámara,
# detector y redes propias andan; conversar y marca/modelo, no.
# Si están las dos claves gana DeepSeek, salvo que se diga acá: deepseek | gemini
LLM=

# DeepSeek (platform.deepseek.com → API keys; se paga por uso, con saldo cargado).
# Conversa POR ESCRITO: no tiene audio. En el emulador escucha y habla el navegador
# (Edge o Chrome); unas gafas de verdad todavía no pueden hablar con este LLM.
# También mira el recorte del aparato para marca y modelo.
# Verificado el 2-oct-2026 en api-docs.deepseek.com: deepseek-flash (conversa, usa
# herramientas y ve imágenes) · deepseek-v4-pro (más caro y NO ve imágenes).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# Gemini (Live API): escucha y habla él, con audio de verdad.
# ⚠️ Usar una clave NUEVA, de otro proyecto de AI Studio, no la de MIIA: comparten
# cuota, y un 429 en class25B durante la corrida de medición sería culpa de las gafas.
GEMINI_API_KEY=

# Modelo de la Live API. Verificado el 1-oct-2026 en ai.google.dev: los tres cuestan
# lo mismo y tienen capa gratuita.
#   gemini-3.8-live · gemini-3.8-live-extended-thinking · gemini-3.1-flash-live-preview
GEMINI_LIVE_MODEL=gemini-3.8-live

# Modelo para «¿qué modelo es este aparato?». Se usa sólo cuando lo pedís, con el
# recorte del recuadro, y sólo para aparatos (nunca para personas). Verificado el
# 2-oct-2026 en ai.google.dev: gemini-3.8-flash (mejor) · gemini-3.5-flash-lite (más barato).
GEMINI_VISION_MODEL=gemini-3.8-flash

# Campo de visión diagonal de la cámara, en grados. Con esto se calcula la distancia
# a un vehículo por su tamaño en la imagen. 55 es la Logitech C270; para otra cámara
# va el de su hoja de datos. Si la distancia sale siempre corrida, es este número.
CAMARA_FOV_DIAGONAL=55

# Sólo con Gemini. 1 = además del audio, se le manda 1 cuadro por segundo al LLM (ve lo que mirás).
# 0 = el LLM sólo escucha y habla; ver es trabajo de la red propia. Es el defecto.
VISION_AL_LLM=0

# Dónde escucha el cerebro. Con 127.0.0.1 sólo entra esta PC (el emulador).
# Para que entren el ESP32 o el celular hay que poner 0.0.0.0 Y un TOKEN_GAFAS:
# sin token el servidor se niega a arrancar abierto a la red.
HOST=127.0.0.1
PUERTO=8787
TOKEN_GAFAS=

# La base de las gafas, en el MySQL de XAMPP (opcional). Crear la base y un usuario
# que sólo pueda tocarla, y poner acá su clave. Sin estas líneas, o con MySQL apagado,
# el cerebro anda igual y guarda lo aprendido sólo en estado/.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gafas
DB_USER=gafas
DB_PASS=

# Quién vota en la red general. Con DINOv2 bajado vota sólo él: los dos extractores
# hechos a mano no suman (91,2 % contra 91,3 %, medido el 2-oct-2026) y cuestan tiempo.
# «todos» vuelve al voto de los tres, para comparar.
VOTANTES=
